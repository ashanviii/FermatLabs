# Firebase web configuration (safe to expose to the browser, but project-specific)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-side Firebase Admin project identity
FIREBASE_PROJECT_ID=

# Local emulator dry runs only:
# NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Choose exactly one credential source. Never commit either value.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Server-side AI provider. Never prefix these values with NEXT_PUBLIC_.
FERMAT_AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# AI Labs is fail-closed. Enable it only with an explicit Firebase token allowlist.
# FERMAT_AI_LABS_ENABLED=true
# FERMAT_AI_LABS_UIDS=firebase-uid-1,firebase-uid-2
# FERMAT_AI_LABS_EMAILS=maintainer@example.com

# Optional Groq fallback. Keep FERMAT_AI_PROVIDER=openai unless intentionally switching.
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b
